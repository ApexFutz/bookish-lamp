# Copy to .env and fill in. Never commit the real .env (issue #6).
# The app fails fast if SECRET_KEY is missing in non-DEBUG mode.

SECRET_KEY=dev-only-change-me
DEBUG=True

# Comma-separated. Required when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Prototype uses SQLite when DATABASE_URL is unset.
# Production (managed Postgres on the client-owned PaaS) sets e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Sessions (issue #8). Idle timeout in seconds (default 28800 = 8h shift).
SESSION_COOKIE_AGE=28800
# End the session when the browser closes (safer on shared floor terminals).
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# Login lockout (issue #11). Failed attempts before lockout, and lockout duration in hours.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1

# First-admin bootstrap (issue #25). Used once, by `python manage.py bootstrap_admin`,
# to create the initial super-admin on a fresh install; ignored once an admin exists.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

# Email (issue #10). Dev uses the console backend; set these for real SMTP in production.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=bookish-lamp <no-reply@yourcompany.com>
